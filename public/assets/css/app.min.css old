/* regular step */
.main-content-001 .step .circle {
    background-color: var(--btn-light-bg);
    border: 3px solid var(--btn-light-bg);
    border-radius: 100%;
    width: 20px;
    height: 20px;
    display: inline-block;
}

.main-content-001 .step .line {
    top: 23px;
    left: 8px;
    /*   height: 120px; */
    height: 100%;
    position: absolute;
    border-left: 3px solid var(--btn-light-bg);
}

.main-content-001 .step.completed .circle {
    visibility: visible;
    background-color: var(--new-color-prime);
    border-color: var(--new-color-prime);
}

.main-content-001 .step.completed .circle {
    position: relative;
    border: 2px solid var(--new-color-prime);
    border-radius: 50%;

    background-color: var(--new-color-prime);
}

/* tick mark */
.main-content-001 .step.completed .circle::after {
    content: "";
    position: absolute;
    left: 5px;
    top: 2px;
    width: 6px;
    height: 11px;
    border: solid #fff;
    /* white tick */
    border-width: 0 3px 3px 0;
    transform: rotate(45deg);
}

.main-content-001 .step.completed .line {
    border-left: 3px solid var(--new-color-prime);
}

.main-content-001 .step.active .circle {
    visibility: visible;
    border-color: var(--new-color-prime);
}

.main-content-001 .step.empty .circle {
    visibility: hidden;
}

.main-content-001 .step.empty .line {
    /*     visibility: hidden; */
    /*   height: 150%; */
    top: 0;
    height: 150%;
}

.main-content-001 .step:last-child .line {
    border-left: 3px solid white;
    z-index: -1;
    /* behind the circle to completely hide */
}

