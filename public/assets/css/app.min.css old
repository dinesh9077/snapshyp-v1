/* ======================= */

/* ===== Submenu Timeline Style ===== */

.nav-second-level {
    position: relative;
    padding-left: 28px;
}

/* Vertical line */
.nav-second-level::before {
    content: "";
    position: absolute;
    left: 16px;
    top: 16px;
    bottom: 16px;
    width: 1px;
    background: #e0e0e0;
}

/* Sub menu items */
.nav-second-level li {
    position: relative;
}

/* Dot */
.nav-second-level li::before {
    content: "";
    position: absolute;
    left: -21px;
    top: 50%;
    transform: translateY(-50%);
    width: 5px;
    height: 5px;
    background: #cfd8dc;
    border-radius: 50%;
    transition: 0.3s ease;
}

/* Links */
.nav-second-level li a {
    color: #5c6b7a;
    transition: 0.3s ease;
}

/* Hover */
.nav-second-level li:hover a {
    color: #ff5722;
}

.nav-second-level li:hover::before {
    background: #ff5722;
}

.nav-second-level li.mm-active::before {
    background: #ff5722;
}

